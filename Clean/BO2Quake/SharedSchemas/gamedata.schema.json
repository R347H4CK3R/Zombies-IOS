{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bo2quake/gamedata.schema.json",
  "title": "BO2 Quake GameData Manifest",
  "type": "object",
  "required": ["formatVersion", "assets", "completion", "failures", "complete"],
  "properties": {
    "formatVersion": {"const": 1},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "version", "sourceHash", "dependencies", "payloads", "validation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "version": {"type": "integer", "minimum": 1},
          "sourceHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "payloads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "path", "size", "sha256"],
              "properties": {
                "name": {"type": "string"},
                "path": {"type": "string"},
                "size": {"type": "integer", "minimum": 0},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "validation": {"enum": ["complete", "failed", "unsupported"]}
        }
      }
    },
    "completion": {"type": "object"},
    "failures": {"type": "array", "items": {"type": "string"}},
    "complete": {"type": "boolean"}
  }
}
